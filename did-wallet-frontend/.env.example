# ─── Contract Addresses ──────────────────────────────────────────────────────
# Set these after running: forge script script/Deploy.s.sol --rpc-url http://localhost:8545 --broadcast
# The addresses are also saved to deployment.json at the project root after deployment.

VITE_DID_REGISTRY_ADDRESS=
VITE_ISSUER_REGISTRY_ADDRESS=
VITE_CREDENTIAL_REGISTRY_ADDRESS=

# ─── Network ──────────────────────────────────────────────────────────────────
# Default: Anvil local node.  Change to a testnet RPC URL for public deployment.
VITE_RPC_URL=http://localhost:8545
VITE_CHAIN_ID=31337

# ─── Optional: Pinata IPFS ────────────────────────────────────────────────────
# Used by the frontend to upload credential documents to IPFS via Pinata.
# Get a free API key at https://app.pinata.cloud/
VITE_PINATA_JWT=
